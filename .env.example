# ============================================================
# Assamese RAG — environment configuration
# Copy to `.env` and fill in the blanks.
# ============================================================

# --- Sarvam AI (STT: saaras:v3, LLM: sarvam-30b, Vision OCR fallback) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LLM_MODEL=sarvam-105b-conversations

# --- PostgreSQL ---
POSTGRES_URL=postgresql+psycopg://postgres:postgres@postgres:5432/assamese_rag

# --- Qdrant (dense vectors) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=assamese_doc_chunks

# --- OpenSearch (BM25) ---
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=assamese_doc_chunks_bm25
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- S3 / object storage (MinIO for local) ---
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=assamese-rag
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_HARD_DELETE_ON_DOC_DELETE=false

# --- Hugging Face Inference API (embeddings + reranker) ---
# HF_TOKEN is still used by the reranker (small payloads, reliable).
HF_TOKEN=
BGE_M3_MODEL_PATH_OR_ENDPOINT=BAAI/bge-m3
BGE_M3_DIM=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_PARALLEL_WORKERS=4
BGE_RERANKER_MODEL_PATH_OR_ENDPOINT=BAAI/bge-reranker-v2-m3

# Embeddings backend:
#   BGE_M3_FORCE_LOCAL=1  -> run BGE-M3 locally (no external dependency, needs
#                            ~3 GB free RAM; model loads once at API startup).
#                            Recommended: HF's free serverless inference for
#                            bge-m3 is unreliable (502s, long cold-starts).
#   BGE_M3_FORCE_LOCAL=0  -> use HF Inference API for embeddings (needs HF_TOKEN,
#                            lower RAM, but depends on HF being up).
BGE_M3_FORCE_LOCAL=1
# Only used when BGE_M3_FORCE_LOCAL=0. HF serverless models cold-start in
# 20-60s after idle; the 18s default would time out and trip a RAM-heavy
# local fallback. Also applies to the reranker.
HF_EMBED_TIMEOUT_SECONDS=120
HF_RERANK_TIMEOUT_SECONDS=120

# --- OCR engine selection ---
OCR_PRIMARY_ENGINE=paddleocr
OCR_FALLBACK_ENGINE=sarvam_vision
OCR_CONFIDENCE_THRESHOLD=0.60

# --- Chunking (P0/P2) ---
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=50
CHUNK_OVERLAP_TOKENS=50
UNICODE_QUALITY_THRESHOLD=0.45
DEFAULT_DOCUMENT_LANGUAGE=as

# --- Retrieval (P3) ---
DENSE_TOP_K=25
BM25_TOP_K=25
RRF_TOP_K=25
RRF_K=60
MMR_TOP_K=20
MMR_LAMBDA=0.7
RERANK_INPUT_TOP_K=30
RERANK_TOP_K=8
CONTEXT_MAX_TOKENS=4000
DEBUG_RETRIEVAL=true
CONVERSATION_MEMORY_TURNS=6

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50
# REQUIRED — no default. Single-tenant "universal" user; must be a valid UUID.
# Generate one:  python -c "import uuid; print(uuid.uuid4())"
UNIVERSAL_USER_ID=00000000-0000-0000-0000-000000000001

# --- Voice WebSocket server (voice_ws_server.py) ---
# Defaults are fine for local/compose; RAG_API_URL points at the API service.
VOICE_WS_HOST=0.0.0.0
VOICE_WS_PORT=8766
RAG_API_URL=http://localhost:8000/api/v1/chat/text
